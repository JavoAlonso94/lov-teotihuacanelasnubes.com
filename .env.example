# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# --- Base de datos / backend (públicas) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Solo servidor (secretas) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Clip (pagos) ---
# Clave pública (API key) usada por el SDK en el navegador
CLIP_API_KEY=
# Token Basic (base64 de apikey:secret). SOLO servidor
CLIP_API_SECRET=

# URL pública del sitio (webhook y metadata antifraude)
SITE_URL=https://teotihuacanenlasnubes.com
